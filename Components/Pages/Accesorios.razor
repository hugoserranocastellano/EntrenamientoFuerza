@page "/accesorios"
@attribute [Authorize]
@using System.ComponentModel.DataAnnotations
@using EntrenamientoFuerza.Data
@using EntrenamientoFuerza.Models
@using EntrenamientoFuerza.Services
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject SupabaseStorageService Storage
@rendermode InteractiveServer

<PageTitle>Accesorios · Entrenamiento Fuerza</PageTitle>

<h1>Accesorios</h1>

@if (mensajeError is not null)
{
    <div class="alert alert-danger">@mensajeError</div>
}

@if (accesorios is null)
{
    <p>Cargando...</p>
}
else
{
    <div class="row g-3 mb-4">
        @foreach (var accesorio in accesorios)
        {
            <div class="col-6 col-md-3">
                <div class="card h-100">
                    @if (!string.IsNullOrWhiteSpace(accesorio.ImagenUrl))
                    {
                        <img src="@accesorio.ImagenUrl" class="card-img-top" style="aspect-ratio:1; object-fit:cover;" alt="" />
                    }
                    else
                    {
                        <div class="bg-light border-bottom d-flex align-items-center justify-content-center text-muted small" style="aspect-ratio:1;">
                            Sin imagen
                        </div>
                    }
                    <div class="card-body p-2">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <span class="small fw-semibold">@accesorio.Nombre</span>
                            <button type="button" class="btn btn-sm btn-outline-danger" @onclick="() => Eliminar(accesorio)">✕</button>
                        </div>
                        <InputFile class="form-control form-control-sm" OnChange="e => CambiarImagen(accesorio, e)" disabled="@(subiendoId == accesorio.Id)" />
                        @if (subiendoId == accesorio.Id)
                        {
                            <span class="small text-muted">Subiendo...</span>
                        }
                    </div>
                </div>
            </div>
        }
    </div>

    <h2 class="h5">Nuevo accesorio</h2>
    <EditForm Model="nuevoModelo" OnValidSubmit="Anadir" class="col-md-4">
        <DataAnnotationsValidator />
        <div class="mb-2">
            <InputText class="form-control" @bind-Value="nuevoModelo.Nombre" placeholder="Nombre (ej. Mancuernas)" />
        </div>
        <div class="mb-2">
            <InputFile class="form-control" OnChange="ElegirImagenNueva" disabled="@subiendoNuevo" />
            @if (subiendoNuevo)
            {
                <span class="small text-muted">Subiendo...</span>
            }
            @if (!string.IsNullOrWhiteSpace(nuevoModelo.ImagenUrl))
            {
                <img src="@nuevoModelo.ImagenUrl" class="mt-2 rounded" style="width:5rem;height:5rem;object-fit:cover;" alt="" />
            }
        </div>
        <button type="submit" class="btn btn-primary">Añadir</button>
    </EditForm>
}

@code {
    private List<Accesorio>? accesorios;
    private DatosAccesorio nuevoModelo = new();
    private string? mensajeError;
    private bool subiendoNuevo;
    private int? subiendoId;

    private const string Bucket = "Accesorios";

    protected override async Task OnInitializedAsync() => await Cargar();

    private async Task Cargar()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        accesorios = await db.Accesorios.OrderBy(a => a.Nombre).ToListAsync();
    }

    private async Task ElegirImagenNueva(InputFileChangeEventArgs e)
    {
        subiendoNuevo = true;
        try
        {
            nuevoModelo.ImagenUrl = await SubirAsync(e.File);
        }
        catch (Exception ex)
        {
            mensajeError = ex.Message;
        }
        finally
        {
            subiendoNuevo = false;
        }
    }

    private async Task CambiarImagen(Accesorio accesorio, InputFileChangeEventArgs e)
    {
        subiendoId = accesorio.Id;
        try
        {
            var url = await SubirAsync(e.File);

            await using var db = await DbFactory.CreateDbContextAsync();
            await db.Accesorios.Where(a => a.Id == accesorio.Id)
                .ExecuteUpdateAsync(a => a.SetProperty(x => x.ImagenUrl, url));

            accesorio.ImagenUrl = url;
        }
        catch (Exception ex)
        {
            mensajeError = ex.Message;
        }
        finally
        {
            subiendoId = null;
        }
    }

    private async Task<string> SubirAsync(IBrowserFile fichero)
    {
        var extension = Path.GetExtension(fichero.Name);
        var ruta = $"{Guid.NewGuid():N}{extension}";

        await using var stream = fichero.OpenReadStream(10 * 1024 * 1024);
        return await Storage.SubirAsync(Bucket, ruta, stream,
            string.IsNullOrWhiteSpace(fichero.ContentType) ? "application/octet-stream" : fichero.ContentType);
    }

    private async Task Anadir()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        db.Accesorios.Add(new Accesorio { Nombre = nuevoModelo.Nombre!.Trim(), ImagenUrl = nuevoModelo.ImagenUrl });

        try
        {
            await db.SaveChangesAsync();
        }
        catch (DbUpdateException)
        {
            mensajeError = "Ya existe un accesorio con ese nombre.";
            return;
        }

        nuevoModelo = new DatosAccesorio();
        mensajeError = null;
        await Cargar();
    }

    private async Task Eliminar(Accesorio accesorio)
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var entidad = await db.Accesorios.Include(a => a.Ejercicios).FirstOrDefaultAsync(a => a.Id == accesorio.Id);
        if (entidad is not null)
        {
            db.Accesorios.Remove(entidad);
            await db.SaveChangesAsync();
        }

        await Cargar();
    }

    private sealed class DatosAccesorio
    {
        [Required(ErrorMessage = "Indica un nombre.")]
        public string? Nombre { get; set; }
        public string? ImagenUrl { get; set; }
    }
}
