@page "/ejercicios/nuevo"
@page "/ejercicios/{Id:int}"
@attribute [Authorize]
@using System.ComponentModel.DataAnnotations
@using EntrenamientoFuerza.Data
@using EntrenamientoFuerza.Models
@using EntrenamientoFuerza.Services
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject NavigationManager Navigation
@inject IJSRuntime JS
@rendermode InteractiveServer

<PageTitle>@(Id is null ? "Nuevo ejercicio" : "Editar ejercicio") · Entrenamiento Fuerza</PageTitle>

<h1>@(Id is null ? "Nuevo ejercicio" : "Editar ejercicio")</h1>

@if (modelo is null || gruposMusculares is null || accesorios is null)
{
    <p>Cargando...</p>
}
else
{
    @if (mensajeError is not null)
    {
        <div class="alert alert-danger">@mensajeError</div>
    }

    <EditForm Model="modelo" OnValidSubmit="Guardar" class="col-md-6">
        <DataAnnotationsValidator />

        <div class="mb-3">
            <label class="form-label">Nombre</label>
            <InputText class="form-control" @bind-Value="modelo.Nombre" />
            <ValidationMessage For="() => modelo.Nombre" class="small" />
        </div>

        <div class="mb-3">
            <label class="form-label">Descripción</label>
            <InputTextArea class="form-control" @bind-Value="modelo.Descripcion" rows="3" />
        </div>

        <div class="mb-3">
            <label class="form-label">Vídeo (enlace de YouTube)</label>
            <div class="input-group">
                <InputText class="form-control" @bind-Value="modelo.VideoUrl" placeholder="https://www.youtube.com/watch?v=..." />
                <button type="button" class="btn btn-outline-secondary" @onclick="Pegar">Pegar</button>
            </div>
            <div class="form-text">
                @if (!string.IsNullOrWhiteSpace(modelo.Nombre))
                {
                    <a href="@YoutubeHelper.UrlBusqueda(modelo.Nombre + " ejercicio técnica")" target="_blank" rel="noopener">
                        Buscar "@modelo.Nombre" en YouTube
                    </a>
                    <text> — copia la URL del vídeo que quieras y vuelve aquí a pulsar "Pegar".</text>
                }
                else
                {
                    <text>Pon primero un nombre para poder buscarlo en YouTube.</text>
                }
            </div>

            @{ var embedUrl = string.IsNullOrWhiteSpace(modelo.VideoUrl) ? null : YoutubeHelper.EmbedUrl(modelo.VideoUrl); }
            @if (embedUrl is not null)
            {
                <div class="ratio ratio-16x9 mt-2" style="max-width: 24rem;">
                    <iframe src="@embedUrl" allowfullscreen></iframe>
                </div>
            }
        </div>

        <div class="mb-3">
            <label class="form-label">Grupo muscular</label>
            <InputSelect class="form-select" @bind-Value="modelo.GrupoMuscularId">
                <option value="">-- sin especificar --</option>
                @foreach (var grupo in gruposMusculares!)
                {
                    <option value="@grupo.Id">@grupo.Nombre</option>
                }
            </InputSelect>
        </div>

        <div class="mb-3">
            <label class="form-label d-block">Accesorios</label>
            @foreach (var accesorio in accesorios!)
            {
                <div class="form-check form-check-inline">
                    <input type="checkbox" class="form-check-input" id="@($"acc-{accesorio.Id}")"
                           checked="@modelo.AccesorioIds.Contains(accesorio.Id)"
                           @onchange="e => AlternarAccesorio(accesorio.Id, (bool)e.Value!)" />
                    <label class="form-check-label" for="@($"acc-{accesorio.Id}")">@accesorio.Nombre</label>
                </div>
            }
            @if (accesorios.Count == 0)
            {
                <p class="text-muted small mb-0">No hay accesorios creados todavía (página "Accesorios" del menú).</p>
            }
        </div>

        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-primary">Guardar</button>
            <a href="ejercicios" class="btn btn-outline-secondary">Cancelar</a>
            @if (Id is not null)
            {
                <button type="button" class="btn btn-outline-danger ms-auto" @onclick="Desactivar">Eliminar</button>
            }
        </div>
    </EditForm>
}

@code {
    [Parameter]
    public int? Id { get; set; }

    private DatosEjercicio? modelo;
    private List<GrupoMuscular>? gruposMusculares;
    private List<Accesorio>? accesorios;
    private string? mensajeError;

    protected override async Task OnInitializedAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        gruposMusculares = await db.GruposMusculares.OrderBy(g => g.Nombre).ToListAsync();
        accesorios = await db.Accesorios.OrderBy(a => a.Nombre).ToListAsync();

        if (Id is null)
        {
            modelo = new DatosEjercicio();
            return;
        }

        var ejercicio = await db.Ejercicios.Include(e => e.Accesorios).FirstOrDefaultAsync(e => e.Id == Id.Value);
        if (ejercicio is null)
        {
            Navigation.NavigateTo("ejercicios");
            return;
        }

        modelo = new DatosEjercicio
        {
            Nombre = ejercicio.Nombre,
            Descripcion = ejercicio.Descripcion,
            VideoUrl = ejercicio.VideoUrl,
            GrupoMuscularId = ejercicio.GrupoMuscularId,
            AccesorioIds = ejercicio.Accesorios.Select(a => a.Id).ToHashSet(),
        };
    }

    private async Task Pegar()
    {
        var modulo = await JS.InvokeAsync<IJSObjectReference>("import", "./js/clipboard.js");
        var texto = await modulo.InvokeAsync<string?>("leer");
        await modulo.DisposeAsync();

        if (!string.IsNullOrWhiteSpace(texto))
        {
            modelo!.VideoUrl = texto.Trim();
        }
        else
        {
            mensajeError = "No se pudo leer el portapapeles. Pega el enlace a mano en el campo.";
        }
    }

    private void AlternarAccesorio(int accesorioId, bool marcado)
    {
        if (marcado)
            modelo!.AccesorioIds.Add(accesorioId);
        else
            modelo!.AccesorioIds.Remove(accesorioId);
    }

    private async Task Guardar()
    {
        await using var db = await DbFactory.CreateDbContextAsync();

        var accesoriosElegidos = await db.Accesorios.Where(a => modelo!.AccesorioIds.Contains(a.Id)).ToListAsync();

        if (Id is null)
        {
            var nuevo = new Ejercicio
            {
                Nombre = modelo!.Nombre!,
                Descripcion = modelo.Descripcion,
                VideoUrl = modelo.VideoUrl,
                GrupoMuscularId = modelo.GrupoMuscularId,
                FechaCreacion = DateTime.UtcNow,
            };
            nuevo.Accesorios.AddRange(accesoriosElegidos);
            db.Ejercicios.Add(nuevo);
        }
        else
        {
            var ejercicio = await db.Ejercicios.Include(e => e.Accesorios).FirstOrDefaultAsync(e => e.Id == Id.Value);
            if (ejercicio is null)
            {
                mensajeError = "El ejercicio ya no existe.";
                return;
            }

            ejercicio.Nombre = modelo!.Nombre!;
            ejercicio.Descripcion = modelo.Descripcion;
            ejercicio.VideoUrl = modelo.VideoUrl;
            ejercicio.GrupoMuscularId = modelo.GrupoMuscularId;
            ejercicio.Accesorios.Clear();
            ejercicio.Accesorios.AddRange(accesoriosElegidos);
        }

        try
        {
            await db.SaveChangesAsync();
        }
        catch (DbUpdateException ex)
        {
            mensajeError = $"No se pudo guardar: {ex.Message}";
            return;
        }

        Navigation.NavigateTo("ejercicios");
    }

    private async Task Desactivar()
    {
        if (Id is null) return;

        await using var db = await DbFactory.CreateDbContextAsync();
        await db.Ejercicios.Where(e => e.Id == Id.Value)
            .ExecuteUpdateAsync(e => e.SetProperty(x => x.Activo, false));

        Navigation.NavigateTo("ejercicios");
    }

    private sealed class DatosEjercicio
    {
        [Required(ErrorMessage = "Indica un nombre.")]
        public string? Nombre { get; set; }
        public string? Descripcion { get; set; }
        public string? VideoUrl { get; set; }
        public int? GrupoMuscularId { get; set; }
        public HashSet<int> AccesorioIds { get; set; } = [];
    }
}
