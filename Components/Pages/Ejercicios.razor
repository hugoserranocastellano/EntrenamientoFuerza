@page "/ejercicios"
@attribute [Authorize]
@using EntrenamientoFuerza.Data
@using EntrenamientoFuerza.Models
@using EntrenamientoFuerza.Services
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<ApplicationDbContext> DbFactory
@rendermode InteractiveServer

<PageTitle>Ejercicios · Entrenamiento Fuerza</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Ejercicios</h1>
    <a href="ejercicios/nuevo" class="btn btn-primary">Nuevo ejercicio</a>
</div>

@if (ejercicios is null)
{
    <p>Cargando...</p>
}
else if (ejercicios.Count == 0)
{
    <p class="text-muted">Todavía no hay ejercicios. Crea el primero.</p>
}
else
{
    <div class="row g-3">
        @foreach (var ejercicio in ejercicios)
        {
            <div class="col-md-4">
                <div class="card h-100">
                    @{ var miniatura = YoutubeHelper.MiniaturaUrl(ejercicio.VideoUrl); }
                    @if (miniatura is not null)
                    {
                        <a href="@($"ejercicios/{ejercicio.Id}")">
                            <img src="@miniatura" class="card-img-top" alt="Vídeo de @ejercicio.Nombre" />
                        </a>
                    }
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start">
                            <h5 class="card-title">@ejercicio.Nombre</h5>
                            @if (ejercicio.GrupoMuscular is not null)
                            {
                                <span class="badge bg-secondary">@ejercicio.GrupoMuscular.Nombre</span>
                            }
                        </div>
                        <p class="card-text text-muted">@ejercicio.Descripcion</p>
                        @if (ejercicio.Accesorios.Count > 0)
                        {
                            <p class="card-text small mb-2">
                                @foreach (var accesorio in ejercicio.Accesorios)
                                {
                                    <span class="badge bg-light text-dark border me-1">@accesorio.Nombre</span>
                                }
                            </p>
                        }
                        <a href="@($"ejercicios/{ejercicio.Id}")" class="btn btn-sm btn-outline-secondary">Editar</a>
                    </div>
                </div>
            </div>
        }
    </div>
}

@code {
    private List<Ejercicio>? ejercicios;

    protected override async Task OnInitializedAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        ejercicios = await db.Ejercicios
            .Where(e => e.Activo)
            .Include(e => e.GrupoMuscular)
            .Include(e => e.Accesorios)
            .OrderBy(e => e.Nombre)
            .ToListAsync();
    }

}
