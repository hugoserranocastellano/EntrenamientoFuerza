@page "/grupos-musculares"
@attribute [Authorize]
@using System.ComponentModel.DataAnnotations
@using EntrenamientoFuerza.Data
@using EntrenamientoFuerza.Models
@using EntrenamientoFuerza.Services
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject SupabaseStorageService Storage
@rendermode InteractiveServer

<PageTitle>Grupos musculares · Entrenamiento Fuerza</PageTitle>

<h1>Grupos musculares</h1>

@if (mensajeError is not null)
{
    <div class="alert alert-danger">@mensajeError</div>
}

@if (grupos is null)
{
    <p>Cargando...</p>
}
else
{
    <div class="row g-3 mb-4">
        @foreach (var grupo in grupos)
        {
            <div class="col-6 col-md-3">
                <div class="card h-100">
                    @if (!string.IsNullOrWhiteSpace(grupo.ImagenUrl))
                    {
                        <img src="@grupo.ImagenUrl" class="card-img-top" style="aspect-ratio:1; object-fit:cover;" alt="" />
                    }
                    else
                    {
                        <div class="bg-light border-bottom d-flex align-items-center justify-content-center text-muted small" style="aspect-ratio:1;">
                            Sin imagen
                        </div>
                    }
                    <div class="card-body p-2">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <span class="small fw-semibold">@grupo.Nombre</span>
                            <button type="button" class="btn btn-sm btn-outline-danger" @onclick="() => Eliminar(grupo)">✕</button>
                        </div>
                        <InputFile class="form-control form-control-sm" OnChange="e => CambiarImagen(grupo, e)" disabled="@(subiendoId == grupo.Id)" />
                        @if (subiendoId == grupo.Id)
                        {
                            <span class="small text-muted">Subiendo...</span>
                        }
                    </div>
                </div>
            </div>
        }
    </div>

    <h2 class="h5">Nuevo grupo</h2>
    <EditForm Model="nuevoModelo" OnValidSubmit="Anadir" class="col-md-4">
        <DataAnnotationsValidator />
        <div class="mb-2">
            <InputText class="form-control" @bind-Value="nuevoModelo.Nombre" placeholder="Nombre del grupo (ej. Piernas)" />
        </div>
        <div class="mb-2">
            <InputFile class="form-control" OnChange="ElegirImagenNueva" disabled="@subiendoNuevo" />
            @if (subiendoNuevo)
            {
                <span class="small text-muted">Subiendo...</span>
            }
            @if (!string.IsNullOrWhiteSpace(nuevoModelo.ImagenUrl))
            {
                <img src="@nuevoModelo.ImagenUrl" class="mt-2 rounded" style="width:5rem;height:5rem;object-fit:cover;" alt="" />
            }
        </div>
        <button type="submit" class="btn btn-primary">Añadir</button>
    </EditForm>
}

@code {
    private List<GrupoMuscular>? grupos;
    private DatosGrupo nuevoModelo = new();
    private string? mensajeError;
    private bool subiendoNuevo;
    private int? subiendoId;

    private const string Bucket = "GruposMusculares";

    protected override async Task OnInitializedAsync() => await Cargar();

    private async Task Cargar()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        grupos = await db.GruposMusculares.OrderBy(g => g.Nombre).ToListAsync();
    }

    private async Task ElegirImagenNueva(InputFileChangeEventArgs e)
    {
        subiendoNuevo = true;
        try
        {
            nuevoModelo.ImagenUrl = await SubirAsync(e.File);
        }
        catch (Exception ex)
        {
            mensajeError = ex.Message;
        }
        finally
        {
            subiendoNuevo = false;
        }
    }

    private async Task CambiarImagen(GrupoMuscular grupo, InputFileChangeEventArgs e)
    {
        subiendoId = grupo.Id;
        try
        {
            var url = await SubirAsync(e.File);

            await using var db = await DbFactory.CreateDbContextAsync();
            await db.GruposMusculares.Where(g => g.Id == grupo.Id)
                .ExecuteUpdateAsync(g => g.SetProperty(x => x.ImagenUrl, url));

            grupo.ImagenUrl = url;
        }
        catch (Exception ex)
        {
            mensajeError = ex.Message;
        }
        finally
        {
            subiendoId = null;
        }
    }

    private async Task<string> SubirAsync(IBrowserFile fichero)
    {
        var extension = Path.GetExtension(fichero.Name);
        var ruta = $"{Guid.NewGuid():N}{extension}";

        await using var stream = fichero.OpenReadStream(10 * 1024 * 1024);
        return await Storage.SubirAsync(Bucket, ruta, stream,
            string.IsNullOrWhiteSpace(fichero.ContentType) ? "application/octet-stream" : fichero.ContentType);
    }

    private async Task Anadir()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        db.GruposMusculares.Add(new GrupoMuscular { Nombre = nuevoModelo.Nombre!.Trim(), ImagenUrl = nuevoModelo.ImagenUrl });

        try
        {
            await db.SaveChangesAsync();
        }
        catch (DbUpdateException)
        {
            mensajeError = "Ya existe un grupo con ese nombre.";
            return;
        }

        nuevoModelo = new DatosGrupo();
        mensajeError = null;
        await Cargar();
    }

    private async Task Eliminar(GrupoMuscular grupo)
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        // Los ejercicios que lo usaban se quedan sin grupo (SetNull), no se borran.
        await db.GruposMusculares.Where(g => g.Id == grupo.Id).ExecuteDeleteAsync();
        await Cargar();
    }

    private sealed class DatosGrupo
    {
        [Required(ErrorMessage = "Indica un nombre.")]
        public string? Nombre { get; set; }
        public string? ImagenUrl { get; set; }
    }
}
