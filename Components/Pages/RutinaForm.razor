@page "/rutinas/nueva"
@page "/rutinas/{Id:int}"
@attribute [Authorize]
@using System.ComponentModel.DataAnnotations
@using System.Security.Claims
@using EntrenamientoFuerza.Data
@using EntrenamientoFuerza.Models
@using EntrenamientoFuerza.Services
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthState
@inject IJSRuntime JS
@rendermode InteractiveServer

<PageTitle>@(Id is null ? "Nueva rutina" : "Editar rutina") · Entrenamiento Fuerza</PageTitle>

<h1>@(Id is null ? "Nueva rutina" : "Editar rutina")</h1>

@if (modelo is null || ejerciciosDisponibles is null)
{
    <p>Cargando...</p>
}
else
{
    @if (mensajeError is not null)
    {
        <div class="alert alert-danger">@mensajeError</div>
    }

    <EditForm Model="modelo" OnValidSubmit="Guardar">
        <DataAnnotationsValidator />

        <div class="row col-md-8">
            <div class="mb-3">
                <label class="form-label">Nombre</label>
                <InputText class="form-control" @bind-Value="modelo.Nombre" />
                <ValidationMessage For="() => modelo.Nombre" class="small" />
            </div>

            <div class="mb-3">
                <label class="form-label">Descripción</label>
                <InputTextArea class="form-control" @bind-Value="modelo.Descripcion" rows="2" />
            </div>
        </div>

        <h2 class="h5 mt-4">Ejercicios de la rutina</h2>

        @if (filas.Count == 0)
        {
            <p class="text-muted">Añade al menos un ejercicio.</p>
        }

        <div class="row g-3">
            @for (var i = 0; i < filas.Count; i++)
            {
                var indice = i;
                var fila = filas[indice];
                var ejercicio = ejerciciosDisponibles.First(e => e.Id == fila.EjercicioId);
                var miniatura = YoutubeHelper.MiniaturaUrl(ejercicio.VideoUrl);
                var mismoGrupoQueAnterior = indice > 0 && ejercicio.GrupoMuscularId is not null
                    && ejercicio.GrupoMuscularId == ejerciciosDisponibles.First(e => e.Id == filas[indice - 1].EjercicioId).GrupoMuscularId;

                <div class="col-12 col-md-6">
                    <div class="card h-100">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <h3 class="h6 mb-0">@ejercicio.Nombre</h3>
                                <button type="button" class="btn btn-sm btn-outline-danger" @onclick="() => filas.RemoveAt(indice)">Quitar</button>
                            </div>
                            @if (mismoGrupoQueAnterior)
                            {
                                <div class="text-warning small mb-2">Mismo grupo muscular que el anterior</div>
                            }

                            <div class="d-flex gap-3">
                                <div class="flex-shrink-0" style="width: 7rem;">
                                    @if (miniatura is not null)
                                    {
                                        <img src="@miniatura" class="rounded w-100" alt="" />
                                    }
                                    else
                                    {
                                        <div class="rounded bg-light border w-100 h-100 d-flex align-items-center justify-content-center text-muted small" style="min-height: 4rem;">
                                            Sin vídeo
                                        </div>
                                    }
                                </div>

                                <div class="flex-grow-1">
                                    <div class="row g-2">
                                        <div class="col-4">
                                            <label class="form-label small mb-0">Series</label>
                                            <input type="number" min="1" class="form-control form-control-sm" @bind="fila.Series" />
                                        </div>
                                        <div class="col-8">
                                            <label class="form-label small mb-0">
                                                <select class="form-select form-select-sm d-inline-block w-auto py-0" @bind="fila.PorRepeticiones" style="font-size: inherit;">
                                                    <option value="true">Repeticiones</option>
                                                    <option value="false">Duración (seg)</option>
                                                </select>
                                            </label>
                                            @if (fila.PorRepeticiones)
                                            {
                                                <input type="number" min="1" class="form-control form-control-sm" @bind="fila.Repeticiones" />
                                            }
                                            else
                                            {
                                                <input type="number" min="1" class="form-control form-control-sm" @bind="fila.DuracionSegundos" />
                                            }
                                        </div>
                                        <div class="col-12">
                                            <label class="form-label small mb-0">Descanso (seg)</label>
                                            <input type="number" min="0" class="form-control form-control-sm" @bind="fila.DescansoSegundos" />
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

        <button type="button" class="btn btn-outline-secondary my-3" @onclick="AbrirModalSeleccion">+ Añadir ejercicio</button>

        <div class="d-flex gap-2 align-items-center flex-wrap">
            <button type="submit" class="btn btn-primary">
                <i class="bi-floppy" aria-hidden="true">💾</i> Guardar
            </button>
            <a href="rutinas" class="btn btn-outline-secondary">Cancelar</a>

            @if (string.IsNullOrWhiteSpace(modelo.SpotifyPlaylistUrl))
            {
                <button type="button" class="btn btn-outline-success" @onclick="EditarPlaylist">
                    <span aria-hidden="true">🎵</span> Añadir playlist
                </button>
            }
            else
            {
                <a href="@modelo.SpotifyPlaylistUrl" target="_blank" rel="noopener" class="btn btn-success">
                    <span aria-hidden="true">🎵</span> Abrir playlist
                </a>
                <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="EditarPlaylist">Cambiar</button>
            }

            @if (Id is not null)
            {
                <button type="button" class="btn btn-outline-danger ms-auto" @onclick="Desactivar">Eliminar</button>
            }
        </div>
    </EditForm>
}

@if (mostrarModal)
{
    <div class="modal d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">
                        @(ejercicioParaAnadirId is null ? "Elige un ejercicio" : "Detalles del ejercicio")
                    </h5>
                    <button type="button" class="btn-close" @onclick="CerrarModal"></button>
                </div>
                <div class="modal-body">
                    @if (ejercicioParaAnadirId is null)
                    {
                        <div class="row g-2">
                            @foreach (var ej in ejerciciosDisponibles!)
                            {
                                var miniaturaModal = YoutubeHelper.MiniaturaUrl(ej.VideoUrl);
                                <div class="col-6 col-md-4">
                                    <button type="button" class="btn btn-outline-secondary w-100 h-100 p-2 text-start" @onclick="() => SeleccionarEjercicio(ej.Id)">
                                        @if (miniaturaModal is not null)
                                        {
                                            <img src="@miniaturaModal" class="rounded w-100 mb-1" alt="" />
                                        }
                                        <div class="small">@ej.Nombre</div>
                                    </button>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        var ejercicioElegido = ejerciciosDisponibles!.First(e => e.Id == ejercicioParaAnadirId);
                        <h6>@ejercicioElegido.Nombre</h6>
                        <div class="row g-2">
                            <div class="col-4">
                                <label class="form-label small">Series</label>
                                <input type="number" min="1" class="form-control" @bind="nuevaFilaSeries" />
                            </div>
                            <div class="col-8">
                                <label class="form-label small d-block">Tipo</label>
                                <select class="form-select" @bind="nuevaFilaPorRepeticiones">
                                    <option value="true">Repeticiones</option>
                                    <option value="false">Duración (seg)</option>
                                </select>
                            </div>
                            <div class="col-6">
                                @if (nuevaFilaPorRepeticiones)
                                {
                                    <label class="form-label small">Repeticiones</label>
                                    <input type="number" min="1" class="form-control" @bind="nuevaFilaRepeticiones" />
                                }
                                else
                                {
                                    <label class="form-label small">Duración (seg)</label>
                                    <input type="number" min="1" class="form-control" @bind="nuevaFilaDuracion" />
                                }
                            </div>
                            <div class="col-6">
                                <label class="form-label small">Descanso (seg)</label>
                                <input type="number" min="0" class="form-control" @bind="nuevaFilaDescanso" />
                            </div>
                        </div>
                    }
                </div>
                <div class="modal-footer">
                    @if (ejercicioParaAnadirId is not null)
                    {
                        <button type="button" class="btn btn-outline-secondary" @onclick="() => ejercicioParaAnadirId = null">Atrás</button>
                        <button type="button" class="btn btn-primary" @onclick="ConfirmarAnadirEjercicio">Añadir</button>
                    }
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter]
    public int? Id { get; set; }

    private DatosRutina? modelo;
    private List<Ejercicio>? ejerciciosDisponibles;
    private List<FilaEjercicio> filas = [];
    private string? mensajeError;

    private bool mostrarModal;
    private int? ejercicioParaAnadirId;
    private int nuevaFilaSeries = 3;
    private bool nuevaFilaPorRepeticiones = true;
    private int? nuevaFilaRepeticiones;
    private int? nuevaFilaDuracion;
    private int nuevaFilaDescanso = 60;

    protected override async Task OnInitializedAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        ejerciciosDisponibles = await db.Ejercicios.Where(e => e.Activo).Include(e => e.GrupoMuscular).OrderBy(e => e.Nombre).ToListAsync();

        if (Id is null)
        {
            modelo = new DatosRutina();
            return;
        }

        var rutina = await db.Rutinas.Include(r => r.RutinaEjercicios).FirstOrDefaultAsync(r => r.Id == Id.Value);
        if (rutina is null)
        {
            Navigation.NavigateTo("rutinas");
            return;
        }

        modelo = new DatosRutina { Nombre = rutina.Nombre, Descripcion = rutina.Descripcion, SpotifyPlaylistUrl = rutina.SpotifyPlaylistUrl };
        filas = rutina.RutinaEjercicios
            .OrderBy(re => re.Orden)
            .Select(re => new FilaEjercicio
            {
                EjercicioId = re.EjercicioId,
                Series = re.Series,
                PorRepeticiones = re.Repeticiones is not null,
                Repeticiones = re.Repeticiones,
                DuracionSegundos = re.DuracionSegundos,
                DescansoSegundos = re.DescansoSegundos,
            })
            .ToList();
    }

    private void AbrirModalSeleccion()
    {
        ejercicioParaAnadirId = null;
        mostrarModal = true;
    }

    private void CerrarModal() => mostrarModal = false;

    private void SeleccionarEjercicio(int ejercicioId)
    {
        ejercicioParaAnadirId = ejercicioId;
        nuevaFilaSeries = 3;
        nuevaFilaPorRepeticiones = true;
        nuevaFilaRepeticiones = null;
        nuevaFilaDuracion = null;
        nuevaFilaDescanso = 60;
    }

    private void ConfirmarAnadirEjercicio()
    {
        filas.Add(new FilaEjercicio
        {
            EjercicioId = ejercicioParaAnadirId!.Value,
            Series = nuevaFilaSeries,
            PorRepeticiones = nuevaFilaPorRepeticiones,
            Repeticiones = nuevaFilaRepeticiones,
            DuracionSegundos = nuevaFilaDuracion,
            DescansoSegundos = nuevaFilaDescanso,
        });
        mostrarModal = false;
    }

    private async Task EditarPlaylist()
    {
        var actual = modelo!.SpotifyPlaylistUrl ?? "";
        var resultado = await JS.InvokeAsync<string?>("prompt", "Pega el enlace de la playlist de Spotify:", actual);
        if (resultado is not null)
        {
            modelo.SpotifyPlaylistUrl = string.IsNullOrWhiteSpace(resultado) ? null : resultado.Trim();
        }
    }

    private async Task<int> ObtenerUsuarioIdAsync()
    {
        var estado = await AuthState.GetAuthenticationStateAsync();
        var idTexto = estado.User.FindFirst(ClaimTypes.NameIdentifier)?.Value;
        return int.TryParse(idTexto, out var id) ? id : throw new InvalidOperationException("Usuario no identificado.");
    }

    private async Task Guardar()
    {
        var filasValidas = filas.Where(f => f.EjercicioId > 0).ToList();
        if (filasValidas.Count == 0)
        {
            mensajeError = "Añade al menos un ejercicio válido.";
            return;
        }

        await using var db = await DbFactory.CreateDbContextAsync();

        Rutina rutina;
        if (Id is null)
        {
            rutina = new Rutina
            {
                Nombre = modelo!.Nombre!,
                Descripcion = modelo.Descripcion,
                SpotifyPlaylistUrl = modelo.SpotifyPlaylistUrl,
                CreadoPorId = await ObtenerUsuarioIdAsync(),
                FechaCreacion = DateTime.UtcNow,
            };
            db.Rutinas.Add(rutina);
        }
        else
        {
            var existente = await db.Rutinas.Include(r => r.RutinaEjercicios).FirstOrDefaultAsync(r => r.Id == Id.Value);
            if (existente is null)
            {
                mensajeError = "La rutina ya no existe.";
                return;
            }

            existente.Nombre = modelo!.Nombre!;
            existente.Descripcion = modelo.Descripcion;
            existente.SpotifyPlaylistUrl = modelo.SpotifyPlaylistUrl;
            db.RutinaEjercicios.RemoveRange(existente.RutinaEjercicios);
            rutina = existente;
        }

        var orden = 1;
        foreach (var fila in filasValidas)
        {
            db.RutinaEjercicios.Add(new RutinaEjercicio
            {
                Rutina = rutina,
                EjercicioId = fila.EjercicioId,
                Orden = orden++,
                Series = fila.Series,
                Repeticiones = fila.PorRepeticiones ? fila.Repeticiones : null,
                DuracionSegundos = fila.PorRepeticiones ? null : fila.DuracionSegundos,
                DescansoSegundos = fila.DescansoSegundos,
            });
        }

        try
        {
            await db.SaveChangesAsync();
        }
        catch (DbUpdateException ex)
        {
            mensajeError = $"No se pudo guardar: {ex.Message}";
            return;
        }

        Navigation.NavigateTo("rutinas");
    }

    private async Task Desactivar()
    {
        if (Id is null) return;

        await using var db = await DbFactory.CreateDbContextAsync();
        await db.Rutinas.Where(r => r.Id == Id.Value)
            .ExecuteUpdateAsync(r => r.SetProperty(x => x.Activa, false));

        Navigation.NavigateTo("rutinas");
    }

    private sealed class DatosRutina
    {
        [Required(ErrorMessage = "Indica un nombre.")]
        public string? Nombre { get; set; }
        public string? Descripcion { get; set; }
        public string? SpotifyPlaylistUrl { get; set; }
    }

    private sealed class FilaEjercicio
    {
        public int EjercicioId { get; set; }
        public int Series { get; set; } = 3;
        public bool PorRepeticiones { get; set; } = true;
        public int? Repeticiones { get; set; }
        public int? DuracionSegundos { get; set; }
        public int DescansoSegundos { get; set; } = 60;
    }
}
